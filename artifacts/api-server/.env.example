# Server-only configuration. Supply real secrets through your hosting secret manager.
PORT=8080
DATABASE_URL=postgresql://app:change-me@localhost:5432/yatbiha
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Private Google Cloud Storage bucket/prefix, using Application Default Credentials.
PRIVATE_OBJECT_DIR=/your-private-bucket/yatbiha
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
# Optional opt-in photo description assistance; leave unset to disable.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
# Isolated development integration test only.
TEST_API_BASE_URL=http://localhost:8080
