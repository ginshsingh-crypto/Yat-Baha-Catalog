# Browser/Android/iOS build settings. Never put secret API keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_PREVIEW_MODE=true
# Production host only, without https:// or trailing slash.
EXPO_PUBLIC_DOMAIN=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Set your final store identifiers before running EAS builds.
ANDROID_APPLICATION_ID=
IOS_BUNDLE_IDENTIFIER=
