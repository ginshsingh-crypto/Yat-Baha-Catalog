{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "review": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_PREVIEW_MODE": "true" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_PREVIEW_MODE": "false" }
    }
  },
  "submit": { "production": {} }
}
